# Copy to .env and load using: node --env-file=.env server/index.js
PORT=3000
HOST=127.0.0.1
# Demo accounts are off by default. Set true only for a showcase;
# demo data is kept separate from registered accounts.
DEMO_MODE=false
COOKIE_SECURE=false
# Optional infrastructure; omit for local JSON storage and in-memory sessions.
# DATABASE_URL=postgresql://logibridge:local-password@localhost:5432/logibridge
# REDIS_URL=redis://localhost:6379
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_KEY=replace-with-a-random-internal-key
# OPENAI_API_KEY=your-server-side-key
OPENAI_MODEL=gpt-4.1-mini
# Optional initial administrator (set both, first startup only).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-unique-password-of-at-least-12-characters
# Transactional email (server-only; use a verified sender domain).
# RESEND_API_KEY=your-private-sending-key
# MAIL_FROM=LogiBridge <notifications@your-domain.example>
# MAIL_REPLY_TO=support@your-domain.example
